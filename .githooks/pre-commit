#!/bin/sh
#
# The Agconflo pre-commit gate.
#
# THIS IS A POSIX SHELL SCRIPT AND MUST BE RUN THROUGH `sh`. PowerShell cannot
# execute it directly, so to run it by hand before committing:
#
#     sh .githooks/pre-commit
#
# Enable it for every commit, once per clone. `core.hooksPath` is local
# configuration and so cannot itself be committed:
#
#     git config core.hooksPath .githooks
#
# Bypass deliberately:  git commit --no-verify
# That is an escape hatch for work in progress rather than a secret one, but a
# commit handed over as finished is expected to have passed.

set -u

# Hooks already run from the repository root. Saying so explicitly means running
# this by hand from a subdirectory behaves identically.
cd "$(git rev-parse --show-toplevel)" || exit 1

fail() {
    echo
    echo "pre-commit: $1"
    echo "pre-commit: commit aborted - fix the above, or bypass with 'git commit --no-verify'."
    exit 1
}

# --- secrets -----------------------------------------------------------------
# This repository is public from its first commit, so a leaked key is leaked
# permanently: the history is world-readable and a later removal does not undo
# it. While the workspace is still empty this is the only step that does real
# work, and it stays the most important one afterwards.
#
# `.githooks/` is excluded from the content scan because this file necessarily
# contains the very patterns it searches for, and would otherwise reject its own
# commit.

echo "pre-commit: staged secret scan"

if git diff --cached --name-only --diff-filter=ACM | grep -qE '(^|/)\.env$'; then
    fail "a file named .env is staged; it holds real keys and must never be committed"
fi

secrets=$(
    git diff --cached --diff-filter=ACM -U0 -- . ':(exclude).githooks/' |
        grep -E '^\+' |
        grep -vE '^\+\+\+' |
        grep -E \
            -e 'sk-[A-Za-z0-9_-]{16,}' \
            -e 'gh[pousr]_[A-Za-z0-9]{16,}' \
            -e 'github_pat_[A-Za-z0-9_]{20,}' \
            -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' \
            -e '(OPEN_ROUTER|ANTHROPIC|OPENAI)_API_KEY=[^[:space:]]+'
)
if [ -n "$secrets" ]; then
    echo "$secrets"
    fail "staged changes look like they contain a credential"
fi

# --- docs --------------------------------------------------------------------
# The documentation project holds the requirements graph, and it is gated here
# rather than only in CI because a broken need costs seconds to fix now and a
# round trip to fix after a push. Measured on this repository: 80 ms with a cold
# index, 41 ms with a warm one. That is free next to the cargo gate below, which
# is why it runs first - and why it is deliberately NOT restricted to commits
# that touch docs/. The needs graph is cross-file, and once [codelinks] points
# at ../crates a Rust source change can break it too.
#
# `ubc` is not on PATH: it lives in the gitignored tools/, downloaded by
# scripts/get-ubc.sh, so it is resolved by path. That is deliberate rather than
# incidental - git GUIs run hooks with a minimal environment, so a PATH lookup
# that works in an interactive shell can still fail from an editor's commit
# button. One POSIX script covers both platforms; the Windows binary is ubc.exe.
# Git Bash's MSYS layer does resolve `tools/ubc` to it, but relying on that
# would make this script quietly Windows-only.

echo "pre-commit: docs gate"

UBC="$(pwd)/tools/ubc"
[ -x "$UBC" ] || UBC="$UBC.exe"

# `[ -x ]` IS NOT THE SAME QUESTION AS "does it run", measured 2026-08-18. A
# binary can carry the execute bit and still be refused by group policy - exit
# 126, "This program is blocked by group policy" - which is what AppLocker does
# on this machine to anything outside a permitted path. The exec bit is set, so
# `[ -x ]` answers yes, and the failure then surfaces as whatever the next
# command happens to say. Before this probe existed it surfaced here as
# "the documentation project has diagnostics", aborting the commit and sending
# the author to fix documentation that was perfectly fine - the same
# wrong-diagnosis shape this hook already guards against for a missing cargo and
# for an unavailable licence.
#
# `--version` is the right probe: it is NOT licence-gated (it answers offline
# with a cold cache), it costs one process, and it separates the cases exactly -
# 0 when the binary runs, 126 when policy refuses it.
ubc_runs() {
    "$UBC" --version >/dev/null 2>&1
}

# Both ubc gates below depend on ubCode's free open-source grant, and BOTH
# report an unavailable grant with exit 1 - the same code each uses for a real
# defect. The message is the only discriminator, so it lives here once rather
# than at each call site.
#
# The grant is a network determination against github.com, cached for three
# days, so this path is not hypothetical: it is what a machine that has been
# offline for longer than that sees on every commit. Which is why neither gate
# may treat it as fatal.
#
# `ubc check` was believed to need no licence at all. Measured 2026-08-17, it
# has a five-FILE free tier: one to five files exit 0 unlicensed, six exit 1
# with "Files to index (6) exceeds maximum without license (5)" on stderr and
# nothing on stdout. The earlier measurement had used a single file holding 2000
# needs, so the limit was never reached.
#
# docs/ HAS SINCE CROSSED IT, so this is no longer a branch that waits for some
# future project size: a machine whose licence answer has expired now gets no
# documentation checking at all locally, and is told so. That was accepted
# deliberately when requirements were grouped by subject instead of packed under
# a file limit. CI has the grant and remains the authority.
#
# The match fails closed: if useblocks changes this wording, a licence failure
# starts being reported as a documentation defect. That is the right direction
# for a gate - a visible false alarm rather than a silent hole - and it is one
# of the things to re-measure when the pinned ubc version is bumped.
is_licence_failure() {
    printf '%s' "$1" | grep -qE \
        'Requires active license|Not determined to be an open source project|exceeds maximum without license'
}

if [ ! -f docs/ubproject.toml ]; then
    echo "pre-commit: no docs/ubproject.toml - skipping the docs gate"
elif [ ! -x "$UBC" ]; then
    # Skipped rather than fatal, the same way the cargo gate skips an empty
    # workspace: a fresh clone that has not run the installer can still commit.
    # The message names the command and not the path, because on Windows the
    # resolved path reads `tools/ubc` while the file on disk is `ubc.exe`.
    echo "pre-commit: ubc is not installed - skipping the docs gate"
    echo "pre-commit: install it with 'sh scripts/get-ubc.sh'"
elif ! ubc_runs; then
    # Present, executable by its file mode, and refused anyway. Treated exactly
    # like "not installed": the hook is a convenience and CI is the authority, so
    # an environment that will not run the tool must not block a commit.
    echo "pre-commit: ubc is installed but will not run - skipping the docs gate"
    echo "pre-commit: nothing is wrong with the binary; this is normally a policy"
    echo "pre-commit: allowing execution only from certain paths. CI runs these gates."
else
    licence_unavailable=0

    # NO PATH ARGUMENT, and that is the load-bearing detail here. `ubc check
    # <path>` does not scope the check, it FILTERS THE DIAGNOSTICS: the whole
    # project is still resolved, but findings outside <path> are dropped
    # silently. Measured on a two-directory probe project - `ubc check inside`
    # printed "No errors found" and exited 0 while a needs.id_regex warning sat
    # in outside/bad.rst. Harmless today, because the project root is docs/
    # itself and the argument selects everything; actively dangerous from the
    # moment [codelinks] points at ../crates, when every diagnostic in Rust
    # source would be filtered away by an argument that looks like it merely
    # names the project. Hence the subshell cd instead.
    #
    # The output is captured rather than left to the terminal because it is the
    # only thing separating a real defect from an unavailable licence - see
    # is_licence_failure above. Capturing needs 2>&1, because diagnostics go to
    # stdout and licence refusals to stderr. This is a subshell and not a pipe,
    # so `$?` really is ubc's status.
    #
    # `--deny warning` is already ubc's default, passed explicitly so that a
    # future change to that default cannot quietly loosen this gate.
    echo "pre-commit: ubc check"
    check_output=$( ( cd docs && "$UBC" check --deny warning ) 2>&1 )
    check_status=$?

    if [ -n "$check_output" ]; then
        echo "$check_output"
    fi

    if [ "$check_status" -ne 0 ]; then
        if is_licence_failure "$check_output"; then
            licence_unavailable=1
            echo "pre-commit: WARNING - ubc could not confirm the open-source"
            echo "pre-commit: WARNING - licence grant, so the documentation"
            echo "pre-commit: WARNING - project was NOT checked at all."
            echo "pre-commit: WARNING - This usually means no network access. CI runs it."
        else
            fail "the documentation project has diagnostics"
        fi
    fi

    # The formatter is gated at ANY project size, where `check` is gated only
    # above five files, so it needs its own guard even when check sailed
    # through. That is exactly today's situation, with docs/ inside the free
    # tier: offline, `check` exits 0 and `format` exits 1. What it does not need
    # is to repeat a diagnosis the step above has already made, so when the
    # grant is known to be unavailable it is skipped outright and one cause
    # prints one message.
    #
    # Its failure is ambiguous the same way - exit 1 for both a licence problem
    # and a real formatting difference - and separable only by the message: a
    # genuine difference prints "1 file would be reformatted" and carries none
    # of the licence wording. `--preview` is required, the formatter is Beta.
    if [ "$licence_unavailable" -eq 1 ]; then
        echo "pre-commit: skipping ubc format - the same grant gates it"
    else
        echo "pre-commit: ubc format --check"
        fmt_output=$("$UBC" format --check --preview docs 2>&1)
        fmt_status=$?

        if [ "$fmt_status" -ne 0 ]; then
            echo "$fmt_output"
            if is_licence_failure "$fmt_output"; then
                echo "pre-commit: WARNING - ubc could not confirm the open-source licence"
                echo "pre-commit: WARNING - grant, so the documentation formatter did not run."
                echo "pre-commit: WARNING - This usually means no network access. CI runs it."
            else
                fail "documentation formatting differs; run 'tools/ubc format --preview docs', review it, and stage the result"
            fi
        fi
    fi
fi

# --- docs self-test ----------------------------------------------------------
# scripts/docs-selftest.sh proves the metamodel's rules still fire, by checking a
# directory of deliberately broken needs against golden diagnostics. Measured at
# roughly 150 ms per fixture - the whole docs gate above costs 80 ms - so unlike
# that gate it IS restricted to commits that can affect it.
#
# That filtering is safe here and would not be safe there. Each fixture is
# checked as a ONE-FILE project, so its result depends on nothing but the shared
# config, the rules, the fixture set, the driver, and which ubc is pinned; the
# list below is that closed set. Editing prose in docs/ cannot change a fixture's
# outcome, whereas it can change the docs gate's, because the needs graph is
# cross-file.
#
# The gap in the filter, stated rather than hidden: tools/ubc is gitignored, so a
# hand-swapped binary is invisible to it. CI runs the self-test unconditionally
# and catches that.
#
# Note it keeps working when the gate above stands down - a one-file project
# stays inside ubc's unlicensed free tier, so this needs no network.

if git diff --cached --name-only |
    grep -qE '^(docs/ubproject\.toml|docs/schemas\.json|docs-selftest/|scripts/(docs-selftest|get-ubc)\.sh)'; then
    echo "pre-commit: docs self-test"
    sh scripts/docs-selftest.sh ||
        fail "the metamodel self-test did not produce its expected diagnostics"
else
    echo "pre-commit: docs self-test - nothing staged that can affect it, skipping"
fi

# --- rust --------------------------------------------------------------------
# The Rust gate is written now and skipped until the first crate lands, so it
# does not have to be remembered and retrofitted once there is finally code for
# it to be wrong about.
#
# The skip is necessary, not defensive: cargo refuses to operate on a workspace
# with no members. Measured against this very repository — `cargo fmt --all
# --check` exits 1 with "Failed to find targets", and clippy and test both exit
# 101. An unguarded gate would therefore block every commit until the first
# crate existed.
#
# The probe reads cargo's own answer rather than guessing from the directory
# layout. `cargo metadata --no-deps` emits compact JSON, so an empty workspace
# is literally `"packages":[]`.
#
# cargo has to be probed for separately and FIRST, because the metadata probe
# cannot distinguish "no crates" from "no cargo": with cargo absent it emits
# nothing, the grep fails, and the else branch runs `cargo fmt` straight into
# "command not found" - which this hook would then report as "formatting
# differs; run 'cargo fmt --all'". Measured by running the hook with cargo off
# PATH. That is a wrong diagnosis sending someone to fix a file that is fine,
# the same failure shape the documentation formatter above is guarded against,
# and it blocked the commit outright. Skipping instead of failing matches how
# the docs gate treats a missing ubc: the hook is a convenience, CI is the
# authority, and someone editing only documentation should not need a Rust
# toolchain to commit.

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found - skipping fmt, clippy and tests"
    echo "pre-commit: install the Rust toolchain from https://rustup.rs"
elif cargo metadata --format-version 1 --no-deps 2>/dev/null | grep -q '"packages":\[\]'; then
    echo "pre-commit: workspace has no crates yet - skipping fmt, clippy and tests"
else
    echo "pre-commit: cargo fmt --all --check"
    cargo fmt --all --check ||
        fail "formatting differs; run 'cargo fmt --all', review it, and stage the result"

    # `-D warnings` is what makes this a gate. Clippy exits 0 even when it has
    # findings, so without it the hook would pass on precisely the output it
    # exists to catch. This also subsumes `cargo check`: the clippy driver
    # compiles the same targets and reports a superset of the same diagnostics,
    # so running both would double the cold build for no extra coverage.
    echo "pre-commit: cargo clippy --workspace --all-targets"
    cargo clippy --workspace --all-targets -- -D warnings ||
        fail "clippy reported findings"

    echo "pre-commit: cargo test --workspace --all-targets"
    cargo test --workspace --all-targets --quiet ||
        fail "tests failed"
fi

# --- deliberately absent -----------------------------------------------------
# Line endings are NOT checked. .gitattributes pins `* text=auto eol=lf` and
# rustfmt.toml pins `newline_style = "Unix"`, which together make a CRLF commit
# impossible rather than merely detectable — leaving nothing for a check to find.
#
# The ubCode licence probe (`ubc query cypher`) is NOT run here. That is CI's
# job: it would make every commit depend on a network round trip, and once docs/
# holds more than five files the check step above is a licence probe in its own
# right, since it cannot run unlicensed either. What is lost locally is only the
# distinction between a genuine denial and an unreachable github.com, which the
# CI docs job diagnoses.
#
# These gates all inspect the WORKING TREE, not the staged content - true of the
# cargo steps as much as the docs ones. Staging a fix while leaving the break on
# disk therefore passes, and the reverse fails. Closing that gap needs `git
# stash --keep-index`, which can lose work when a hook aborts and interacts
# badly with untracked files; CI checks the pushed tree and is the authority.

echo "pre-commit: ok"
