# --- secrets -----------------------------------------------------------------
# This repository is public. Nothing below may ever be committed.
.env
.env.*
!.env.example
*.key
*.pem

# --- rust --------------------------------------------------------------------
/target/
**/*.rs.bk

# --- docs (ubc) --------------------------------------------------------------
# Where `ubc build html` writes by default.
docs/_build/

# ubc's project index cache. It writes its own `.gitignore` containing `*`, so
# this entry is belt-and-braces rather than strictly required - it is here to
# document that the directory exists and to keep working if that ever changes.
# No leading slash: ubc creates one per project directory, not only at the root.
.ub_cache/

# --- tools -------------------------------------------------------------------
# Downloaded by scripts/get-ubc.{ps1,sh}. The `ubc` binary is ~66 MB, which is
# both far too large to commit and pointless to: it is pinned by version and
# SHA-256 in those scripts, so any clone can reproduce exactly these bytes.
/tools/

# --- editors / os ------------------------------------------------------------
.idea/
.DS_Store
Thumbs.db
