# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed —
# this repository is public from its first commit, so anything committed here is
# permanently visible to everyone, including in history after a later removal.
#
# Only the key for the provider you actually use is required.

# OpenRouter — the default route for the long tail of models.
OPEN_ROUTER_API_KEY=

# Native provider adapters. Preferred where explicit prompt caching matters,
# because per-message cache_control breakpoints are dropped when Anthropic
# models are routed through OpenRouter.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# A local OpenAI-compatible server, such as LM Studio, for measuring against a
# real model without a provider's key. Use a model the server already has
# loaded; local models are slow and have small context windows, so keep prompts
# short. Nothing in the tests needs these: every test answers from a stub.
LM_STUDIO_BASE_URL=
LM_API_TOKEN=
LM_STUDIO_MODEL=
